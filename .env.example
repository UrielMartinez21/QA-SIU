# Plantilla de variables de entorno para las pruebas E2E.
# Copia este archivo a .env y rellena con tus valores reales.
# El .env real NUNCA se sube al repositorio (esta en .gitignore).

# Credenciales del usuario de pruebas (con permiso finanzas.can_upload_accounting_excel)
E2E_USER=tu_matricula
E2E_PASSWORD=tu_password

# Ambiente por defecto donde corren las pruebas.
# Local:  http://localhost:8000
# Migr:   https://siu-migr.scalahed.com:8023
E2E_BASE_URL=http://localhost:8000
